PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/ai-code-review
JWT_SECRET=replace-with-a-long-random-secret
# DeepSeek API key from platform.deepseek.com. API_SECRET_KEY also works for
# backward compatibility with existing local setups.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional; leave unchanged unless using a compatible DeepSeek endpoint.
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLIENT_URL=http://localhost:5173
# Create an OAuth App at https://github.com/settings/developers. Its callback
# URL must exactly match GITHUB_REDIRECT_URI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5000/api/github/callback

# Optional: enables delivery of OTP emails. Without these values the API returns
# a development OTP for local testing.
EMAIL_USER=
EMAIL_PASSWORD=
